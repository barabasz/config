.DS_Store

# Zsh
zsh/cache/
!zsh/cache/.gitkeep
zsh/.zsh_history
zsh/.zsh_sessions
zsh/lib/.compiled.zsh
zsh/lib/.compiled.zsh.tmp

# Karabiner
karabiner/automatic_backups

# iTerm2
iterm2/AppSupport
iterm2/sockets

# yazi: plugins/flavors installed via `ya pkg` are regenerated by
# `ya pkg install` from yazi/package.toml — only hand-written,
# unpublished plugins stay tracked here.
yazi/plugins/*
!yazi/plugins/copy-extra.yazi
yazi/flavors/*

# Neovim
nvim/lazy-lock.json
