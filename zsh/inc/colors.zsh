#!/usr/bin/env zsh
#
# ANSI color codes - work universally without tput dependency

# Basic colors
r=$'\033[0;31m'      # Red
g=$'\033[0;32m'      # Green
y=$'\033[0;33m'      # Yellow
b=$'\033[0;34m'      # Blue
p=$'\033[0;35m'      # Purple
c=$'\033[0;36m'      # Cyan
w=$'\033[0;37m'      # White
x=$'\033[0m'         # Reset