# Calculate Collatz sequences or analyze ranges statistics
# Usage: collatz <number>
#        collatz <start> <end>
#
#   <number>: Show full trajectory for a single number
#   <start> <end>: Show statistics table for a range of numbers


# Validate argument count
if (( $# < 1 || $# > 2 )); then
    if (( ${+functions[printe]} )); then
        printe "Usage: collatz <number> OR collatz <start> <end>"
    else
        print -u2 "Usage: collatz <number> OR collatz <start> <end>"
    fi
    return 1
fi

integer start_num=$1
integer end_num=0
local mode="single" 

# Validate first argument (must be positive integer)
if [[ "$start_num" != <-> || "$start_num" -lt 1 ]]; then
    if (( ${+functions[printe]} )); then
        printe "Error: First argument must be a positive integer."
    else
        print -u2 "Error: First argument must be a positive integer."
    fi
    return 1
fi

# Determine mode and validate second argument if present
if (( $# == 2 )); then
    end_num=$2
    mode="range"

    if [[ "$end_num" != <-> ]]; then
        if (( ${+functions[printe]} )); then
            printe "Error: Second argument must be a positive integer."
        else
            print -u2 "Error: Second argument must be a positive integer."
        fi
        return 1
    fi
    
    if (( start_num >= end_num )); then
        if (( ${+functions[printe]} )); then
            printe "Error: Range start ($start_num) must be smaller than end ($end_num)."
        else
            print -u2 "Error: Range start ($start_num) must be smaller than end ($end_num)."
        fi
        return 1
    fi
else
    # Single mode: iterate once
    end_num=$start_num
fi

# Print header for range mode
if [[ "$mode" == "range" ]]; then
    local fmt="%-10s | %-15s | %-10s\n"
    print -P "%BCollatz Range Analysis ($start_num - $end_num)%b"
    printf "$fmt" "Number" "Max Value" "Steps"
    print "-------------------------------------------"
fi

# Main Processing Loop
integer i
for (( i = start_num; i <= end_num; i++ )); do
    integer current=$i
    integer steps=0
    integer max_val=$current
    
    # Single mode output: start number
    if [[ "$mode" == "single" ]]; then
        print -n "$current"
    fi

    # Calculate Sequence
    while (( current > 1 )); do
        (( steps++ ))
        
        if (( current % 2 == 0 )); then
            (( current /= 2 ))
        else
            (( current = 3 * current + 1 ))
        fi

        # Track peak
        if (( current > max_val )); then
            (( max_val = current ))
        fi

        # Single mode output: trajectory
        if [[ "$mode" == "single" ]]; then
            print -n " -> $current"
        fi
    done

    # Final Output
    if [[ "$mode" == "single" ]]; then
        print "\n-------------------------"
        print "Steps taken: $steps"
        print "Max value:   $max_val"
    else
        printf "%-10d | %-15d | %-10d\n" $i $max_val $steps
    fi
done
