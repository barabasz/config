# Show loaded shell files in order
local filepath filename fstatus icon time_ms total=0
local time_color name_color indent folder
local i=0 count=${#ZFILES_ORDER} errors=0
local width=${#count}

print "${w}Zsh Shell Configuration Load Time Report${x}"
print "${w}=========================================${x}"

for filepath in $ZFILES_ORDER; do
    (( i++ ))
    filename=${filepath:t}
    fstatus=$ZFILES[$filepath]
    time_ms=$ZFILES_TIME[$filepath]

    # Status icon
    if (( fstatus == 1 )); then
        icon="${g}✓${x}"
    else
        icon="${r}✗${x}"
        (( errors++ ))
    fi

    # Time color
    if (( time_ms > 10 )); then
        time_color=$r
    elif (( time_ms > 5 )); then
        time_color=$y
    elif (( time_ms > 1 )); then
        time_color=$w
    else
        time_color=$g
    fi

    # Main files vs sourced files
    if [[ $filename == .z* ]]; then
        name_color=$y
        indent=""
        folder=""
        total=$(( total + time_ms ))
    else
        name_color=$c
        indent="  "
        folder="${filepath:h:t}"
    fi

    printf "${w}%${width}d.${x} %s ${name_color}%-20s${x} ${time_color}%6.2f ms${x}  ${w}%s${x}\n" \
        "$i" "$icon" "${indent}${filename}" "$time_ms" "$folder"
done

print "${w}------------------------------------------${x}"
printf "${bw}Total loading time:       %6.2f ms${x}\n" "$total"

if (( errors > 0 )); then
    printf "${r}Errors: %d file(s) failed to load${x}\n" "$errors"
fi