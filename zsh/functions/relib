#!/usr/bin/env zsh

# Compile all library files into a single optimized file
# Usage: relib

zmodload zsh/datetime  # For precise timing

local -a source_files
local compiled="$ZHELPERS"
local lib_dir="$ZLIBDIR"
local file_count=0 error_count=0
local start_time end_time elapsed
local temp_file="${compiled}.tmp"

# ANSI colors
local -A colors=(
  cyan    $'\033[0;36m'
  green   $'\033[0;32m'
  yellow  $'\033[0;33m'
  red     $'\033[0;31m'
  reset   $'\033[0m'
)

# Validation
if [[ ! -d "$lib_dir" ]]; then
  print -P "%F{red}Error:%f Directory ${colors[cyan]}$lib_dir${colors[reset]} does not exist"
  return 1
fi

# Get source files (exclude .compiled.zsh and files starting with _ or .)
source_files=($lib_dir/*.zsh(N))
source_files=(${source_files:#$compiled})

if (( ${#source_files} == 0 )); then
  print -P "%F{yellow}Warning:%f No ${colors[cyan]}*.zsh${colors[reset]} files found in ${colors[cyan]}$lib_dir${colors[reset]}"
  return 1
fi

# Start timing
start_time=$EPOCHREALTIME

# Create header in temp file
cat > "$temp_file" <<HEADER
#!/usr/bin/zsh
#
# Auto-generated compiled library
# DO NOT EDIT - regenerate with: relib
# Generated: $(date '+%Y-%m-%d %H:%M:%S')
# Source files: ${#source_files}
#

HEADER

# Process each source file
for file in $source_files; do
  local filename="${file:t}"
  
  print -n "Processing ${colors[cyan]}$filename${colors[reset]}... "
  
  # Add file header
  print "\n#\n# Source: $filename\n#" >> "$temp_file"
  
  # Remove comments and empty lines, append to temp file
  # Keep shebang from first file if present
  if grep -v '^\s*#' "$file" | grep -v '^\s*$' >> "$temp_file" 2>/dev/null; then
    print >> "$temp_file"  # Add blank line between files
    print "${colors[green]}✓${colors[reset]}"
    (( file_count++ ))
  else
    print "${colors[red]}✗${colors[reset]}"
    print -P "%F{red}Error:%f Failed to process $file"
    (( error_count++ ))
  fi
done

# Check if compilation succeeded
if (( error_count > 0 )); then
  print -P "\n%F{red}Compilation failed:%f $error_count error(s) encountered"
  [[ -f "$temp_file" ]] && rm "$temp_file"
  return 1
fi

# Move temp file to final location
if ! mv "$temp_file" "$compiled" 2>/dev/null; then
  print -P "%F{red}Error:%f Cannot write to ${colors[cyan]}$compiled${colors[reset]}"
  [[ -f "$temp_file" ]] && rm "$temp_file"
  return 1
fi

# Calculate elapsed time
end_time=$EPOCHREALTIME
elapsed=$(( (end_time - start_time) * 1000 ))
elapsed=${elapsed%.*}  # Convert to integer (milliseconds)

# Source the compiled file
print -n "\nLoading compiled library... "
if source "$compiled" 2>/dev/null; then
  print "${colors[green]}✓${colors[reset]}"
else
  print "${colors[red]}✗${colors[reset]}"
  print -P "%F{red}Error:%f Syntax error in compiled file"
  print "Run: ${colors[cyan]}zsh -n $compiled${colors[reset]} to check syntax"
  return 1
fi

# Success summary
print -P "\n%F{green}✓ Compilation successful%f"
print "  Files processed: ${colors[yellow]}$file_count${colors[reset]}"
print "  Output file: ${colors[cyan]}${compiled:t}${colors[reset]}"
print "  Time elapsed: ${colors[yellow]}${elapsed}${colors[reset]} ms"

return 0