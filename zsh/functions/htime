# Human readable time
local sec=$1
local d h m

if (( sec < 60 )); then
    print "${sec} sec"
elif (( sec < 3600 )); then
    printf "%.1f min\n" $(( sec / 60.0 ))
elif (( sec < 86400 )); then
    printf "%.1f h\n" $(( sec / 3600.0 ))
else
    d=$(( sec / 86400 ))
    h=$(( (sec % 86400) / 3600 ))
    m=$(( (sec % 3600) / 60 ))
    if (( d == 1 )); then
        print "${d} day ${h}h ${m}m"
    else
        print "${d} days ${h}h ${m}m"
    fi
fi